<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VRCRBSync.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VRCRBSync">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HistoryHeaderText" Style="{StaticResource HeaderTextBlockStyle}" Foreground="White" VerticalAlignment="Center"/>
            <Button x:Name="ClearHistoryButton" Click="ClearHistory_Click" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="16"/>
        </Grid>

        <!-- 空状態の場合のプレースホルダー -->
        <TextBlock x:Name="EmptyPlaceholder" Grid.Row="1"
                   Foreground="Gray" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <ListView x:Name="HistoryList" Grid.Row="1"
                  SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryEntry">
                    <Grid Padding="8,10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{x:Bind PlayedAtFormatted}"
                                   Foreground="#888888" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Artist}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="?" FontSize="12" Foreground="#555555"/>
                                <TextBlock Text="{x:Bind Album}" FontSize="12" Foreground="#666666" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
