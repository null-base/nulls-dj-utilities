<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VRCRBSync.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="20" Padding="0">
        <TextBlock x:Name="HeaderText" Style="{StaticResource HeaderTextBlockStyle}" Foreground="White"/>

        <Border Background="#2D2D2D" CornerRadius="12" Padding="20" Width="500" HorizontalAlignment="Left">
            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Grid Width="80" Height="80">
                    <Border Background="#3E3E3E" CornerRadius="8">
                        <FontIcon x:Name="AlbumArtPlaceholder" Glyph="&#xE93C;" FontSize="32" Foreground="Gray"/>
                    </Border>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <ImageBrush x:Name="AlbumArtBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel VerticalAlignment="Center" MaxWidth="360">
                    <TextBlock x:Name="TitleText" Text="Waiting for track..." FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" Text="rekordbox isn't running" FontSize="14" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AlbumText" Text="" FontSize="12" Foreground="#888888" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Red"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Foreground="LightGray"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="StartButton" Click="StartSync_Click" Style="{StaticResource AccentButtonStyle}" Width="120" CornerRadius="20"/>
            <Button x:Name="StopButton" Click="StopSync_Click" Width="120" CornerRadius="20" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Page>
