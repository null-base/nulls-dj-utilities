<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VRCRBSync.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="24" Padding="0">
            <TextBlock x:Name="SettingsHeaderText" Style="{StaticResource HeaderTextBlockStyle}" Foreground="White"/>

            <!-- OSC Configuration -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="OscSectionText" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

                <Border Background="#2D2D2D" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="HostBox" Header="Host" PlaceholderText="127.0.0.1"/>
                        <NumberBox x:Name="PortBox" Header="Port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Message Format -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="MessageFormatSectionText" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

                <Border Background="#2D2D2D" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="FormatBox" Header="Format template" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                        <TextBlock x:Name="VariablesText" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="PreviewLabelText" FontSize="12" Foreground="Gray" Margin="0,8,0,0"/>
                        <Border Background="#1E1E1E" CornerRadius="4" Padding="8">
                            <TextBlock x:Name="PreviewText" FontSize="12" Foreground="LightGray" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Monitoring -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="MonitoringSectionText" FontSize="18" FontWeight="SemiBold" Foreground="White"/>

                <Border Background="#2D2D2D" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <NumberBox x:Name="IntervalBox" Minimum="500" Maximum="30000" SpinButtonPlacementMode="Compact"/>
                        <ToggleSwitch x:Name="NotifySoundToggle" OnContent="On" OffContent="Off"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Save Button -->
            <Button x:Name="SaveSettingsButton" Click="SaveSettings_Click" Style="{StaticResource AccentButtonStyle}" Width="150" CornerRadius="20"/>

            
            <TextBlock Text="VRCRBSync v1.0.0" FontSize="11" Foreground="#555555" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
